@page "/"
@layout HomeLayout
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Home</PageTitle>

<div class="video-container">
    <video @ref="videoElement" id="homeVideo" class="home-video"
           autoplay muted loop playsinline preload="auto">
        <source src="videos/AssetInspector.mp4" type="video/mp4" />
    </video>

    

    <button type="button" class="btn btn-dark sound-toggle" @onclick="ToggleSound">
        @(_isMuted ? "🔇 Sound off" : "🔊 Sound on")
    </button>
</div>

@code {
    private bool _isMuted = true;
    private ElementReference videoElement;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("videoHelper.play", videoElement);
    }

    private async Task ToggleSound()
    {
        _isMuted = !_isMuted;
        await JS.InvokeVoidAsync("videoHelper.setMuted", videoElement, _isMuted);
    }

    
}

<style>
    .video-container {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    .home-video {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .login-btn {
        position: absolute;
        top: 1.5rem;
        inset-inline-start: 1.5rem; /* top-left in LTR, top-right in RTL */
        z-index: 10;
        padding: 0.5rem 1.5rem;
        font-weight: 600;
        opacity: 0.9;
    }

        .login-btn:hover {
            opacity: 1;
        }

    .sound-toggle {
        position: absolute;
        right: 1.5rem;
        bottom: 1.5rem;
        opacity: 0.85;
        z-index: 10;
    }

        .sound-toggle:hover {
            opacity: 1;
        }
</style>