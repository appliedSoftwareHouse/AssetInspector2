@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject Translator L

<header class="app-header">
    <div class="header-left">
        <AuthorizeView>
            <Authorized>
                <button type="button" class="menu-toggle" @onclick="OnToggleSidebar" title="Toggle menu" aria-label="Toggle menu">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
            </Authorized>
        </AuthorizeView>

        <img src="Images/System/MyLogo.gif" alt="Company Logo" class="header-logo" />
    </div>

    <div class="app-title">@Title</div>

    <div class="header-right">
        <select class="lang-select" value="@CurrentLang" @onchange="ChangeLanguage">
            <option value="en">English</option>
            <option value="ar">العربية</option>
        </select>

        <AuthorizeView>
            <Authorized>
                <a class="auth-btn logout-btn" @onclick="GoLogoutPage">@L["Logout"]</a>
            </Authorized>
            <NotAuthorized>
                <a class="auth-btn login-btn" @onclick="GoLoginPage">@L["Login"]</a>
            </NotAuthorized>
        </AuthorizeView>

        <img src="Images/System/Client.gif" alt="Client" class="header-client" />
    </div>
</header>


@code {
    [Parameter]
    public string Title { get; set; } = "Asset Inspector 2";

    [Parameter]
    public EventCallback OnToggleSidebar { get; set; }

    private string CurrentLang => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private void ChangeLanguage(ChangeEventArgs e)
    {
        var culture = e.Value?.ToString() ?? "en";
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri);
        var returnUrl = "/" + relativePath.TrimStart('/');

        Nav.NavigateTo(
            $"/culture/set?culture={Uri.EscapeDataString(culture)}&redirectUri={Uri.EscapeDataString(returnUrl)}",
            forceLoad: true);
    }

    private void GoLoginPage()
    {
        Nav.NavigateTo("/login");
    }

    private void GoLogoutPage()
    {
        Nav.NavigateTo("/login");
    }

}
