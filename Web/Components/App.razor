@* File: App.razor *@
@using System.Globalization

<!DOCTYPE html>

<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName"
      dir="@(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />

    <link rel="stylesheet" href="lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Web.styles.css"]" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Eczar:wght@400..800&family=Exo+2:wght@100..900&family=Merienda:wght@300..900&family=Merriweather:wght@300;400;700;900&family=Montserrat:wght@100..900&family=Raleway:wght@300;400;500;700&display=swap" rel="stylesheet">

    <style>
            #app-loading {
                position: fixed;
                inset: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'Montserrat', sans-serif;
                color: #6c757d;
                background: #fff;
                z-index: 1;
            }

                /* Hide the loader once Blazor has rendered its content */
                #app-loading:not(:only-child) {
                    display: none;
                }
    </style>

    <ImportMap />
    <HeadOutlet @rendermode="RenderModeNoPrerender" />
</head>

<body>
    <Routes @rendermode="RenderModeNoPrerender" />
    <ReconnectModal />

    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="Videos/video.js"></script>
    <script src="lib/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>

</html>

@code {
    private static readonly IComponentRenderMode RenderModeNoPrerender =
        new InteractiveServerRenderMode(prerender: false);
}